# =====================================================================
# Data is NOT stored in git.
#   data/raw/       - large public downloads (~605 MB). Rebuild with
#                     `bash scripts/download_raw.sh`; verify byte-for-byte
#                     against data/raw/CHECKSUMS.sha256.
#   data/processed/ - regenerated in ~40 s by `Rscript scripts/run_all.R`.
# Tracked instead: scripts, outputs/ (small result tables), figures/,
# docs/ (inventory, dictionary, memo, HTML report), and the manifests
# below so the pipeline is fully reproducible from public sources.
# =====================================================================

data/raw/*
!data/raw/.gitkeep
!data/raw/README.md
!data/raw/CHECKSUMS.sha256

data/processed/*
!data/processed/.gitkeep

# Phase 2 (phase2/) mirrors the same policy: raw/interim/processed are not
# stored in git; scripts, docs (inventories/memo/decision log), outputs and
# figures are.
phase2/data/raw/*
!phase2/data/raw/.gitkeep
!phase2/data/raw/README.md
!phase2/data/raw/CHECKSUMS.sha256

phase2/data/interim/*
!phase2/data/interim/.gitkeep

phase2/data/processed/*
!phase2/data/processed/.gitkeep

# Direction A feasibility pilot (phase2/direction_a_feasibility/) -- same
# policy: raw/interim/processed are not stored in git; scripts, docs,
# outputs and figures are.
phase2/direction_a_feasibility/data/raw/*
!phase2/direction_a_feasibility/data/raw/.gitkeep

phase2/direction_a_feasibility/data/interim/*
!phase2/direction_a_feasibility/data/interim/.gitkeep

phase2/direction_a_feasibility/data/processed/*
!phase2/direction_a_feasibility/data/processed/.gitkeep

# OS / editor / R cruft
.DS_Store
**/.DS_Store
.Rhistory
.RData
.Rproj.user/
*.Rproj
.Renviron
*~
*.swp

# never commit secrets
.env
census_api_key*
